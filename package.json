{
  "name": "pharm-track",
  "version": "0.1.0",
  "private": true,
  "description": "PharmTrack: pharmacy management module of the SynergyOne suite.",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces",
    "test": "npm test -w apps/api",
    "typecheck": "npm run typecheck --workspaces",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
