{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synergyone/pharmtrack/events/supplytrack.stock.return.schema.json",
  "type": "object",
  "properties": {
    "storeId": {
      "type": "string",
      "minLength": 1
    },
    "hptCode": {
      "type": "string",
      "minLength": 3,
      "description": "PPB HPT code"
    },
    "batchNumber": {
      "type": "string",
      "minLength": 1
    },
    "quantity": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "storeId",
    "hptCode",
    "batchNumber",
    "quantity",
    "reason",
    "reference"
  ],
  "additionalProperties": false,
  "description": "Body of POST /stock/returns.",
  "title": "stock.return"
}
