{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synergyone/pharmtrack/events/dispense.completed.schema.json",
  "type": "object",
  "properties": {
    "dispenseEventId": {
      "type": "string",
      "format": "uuid"
    },
    "dispenseOrderId": {
      "type": "string",
      "format": "uuid"
    },
    "prescriptionId": {
      "type": "string",
      "format": "uuid"
    },
    "prescriptionExternalId": {
      "type": "string",
      "minLength": 1
    },
    "patientId": {
      "type": "string",
      "minLength": 1
    },
    "encounterId": {
      "type": "string",
      "minLength": 1
    },
    "facilityId": {
      "type": "string",
      "minLength": 1
    },
    "storeId": {
      "type": "string",
      "minLength": 1
    },
    "fillType": {
      "enum": [
        "INITIAL",
        "REFILL"
      ]
    },
    "fillSequence": {
      "type": "integer",
      "minimum": 0
    },
    "priceListCode": {
      "type": "string",
      "minLength": 1
    },
    "dispensedAt": {
      "type": "string",
      "format": "date-time"
    },
    "dispensedBy": {
      "type": "string",
      "minLength": 1
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "dispenseLineId": {
            "type": "string",
            "format": "uuid"
          },
          "hptCode": {
            "type": "string",
            "minLength": 3,
            "description": "PPB HPT code"
          },
          "atcCode": {
            "type": "string",
            "pattern": "^[A-Z]\\d{2}[A-Z]{2}\\d{2}$",
            "description": "WHO ATC level-5 code"
          },
          "genericName": {
            "type": "string",
            "minLength": 1
          },
          "strength": {
            "type": "string",
            "minLength": 1
          },
          "unitOfIssue": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "batchNumber": {
            "type": "string",
            "minLength": 1
          },
          "expiryDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "unitPrice": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "substitutedFromHptCode": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "dispenseLineId",
          "hptCode",
          "atcCode",
          "genericName",
          "strength",
          "unitOfIssue",
          "quantity",
          "batchNumber",
          "expiryDate",
          "unitPrice",
          "currency",
          "substitutedFromHptCode"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "dispenseEventId",
    "dispenseOrderId",
    "prescriptionId",
    "prescriptionExternalId",
    "patientId",
    "encounterId",
    "facilityId",
    "storeId",
    "fillType",
    "fillSequence",
    "priceListCode",
    "dispensedAt",
    "dispensedBy",
    "lines"
  ],
  "additionalProperties": false,
  "description": "Billable items for one dispense (first fill or refill). CliniTrack invoices and claims these lines.",
  "title": "dispense.completed"
}
