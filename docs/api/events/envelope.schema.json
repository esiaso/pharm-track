{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synergyone/pharmtrack/events/envelope.schema.json",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "type",
    "version",
    "occurredAt",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "Body of POST {CLINITRACK}/integrations/pharmtrack/events. The same idempotencyKey is also sent as the Idempotency-Key header.",
  "title": "PharmTrack \u2192 CliniTrack event envelope"
}
