{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synergyone/pharmtrack/events/supplytrack.stockout.report.schema.json",
  "title": "supplytrack.stockout.report",
  "description": "Monthly stock-out report for one facility, sent to POST {SUPPLYTRACK}/reports/stock-outs.",
  "type": "object",
  "properties": {
    "reportId": {
      "type": "string",
      "format": "uuid"
    },
    "facilityId": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "description": "Calendar month in Africa/Nairobi time"
    },
    "periodFrom": {
      "type": "string",
      "format": "date-time"
    },
    "periodTo": {
      "type": "string",
      "format": "date-time",
      "description": "Exclusive"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "1 for the first submission of the period, higher for amendments"
    },
    "amendsReportId": {
      "type": [
        "string",
        "null"
      ],
      "description": "The earlier submission this one replaces"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "submittedBy": {
      "type": "string",
      "minLength": 1
    },
    "reportType": {
      "const": "STOCK_OUT"
    },
    "summary": {
      "type": "object",
      "properties": {
        "itemsOut": {
          "type": "number"
        },
        "totalDaysOut": {
          "type": "number"
        },
        "stillOut": {
          "type": "number"
        },
        "prescriptionItemsAffected": {
          "type": "number"
        }
      },
      "required": [
        "itemsOut",
        "totalDaysOut",
        "stillOut",
        "prescriptionItemsAffected"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "storeId": {
                "type": "string",
                "minLength": 1
              },
              "hptCode": {
                "type": "string",
                "minLength": 3
              },
              "genericName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "strength": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "episodes": {
                "type": "number"
              },
              "daysOut": {
                "type": "number"
              },
              "outAtEnd": {
                "type": "boolean"
              },
              "prescriptionItemsAffected": {
                "type": "number"
              },
              "firstOutAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "storeId",
              "hptCode",
              "genericName",
              "strength",
              "episodes",
              "daysOut",
              "outAtEnd",
              "prescriptionItemsAffected",
              "firstOutAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "reportId",
    "facilityId",
    "period",
    "periodFrom",
    "periodTo",
    "version",
    "amendsReportId",
    "generatedAt",
    "submittedBy",
    "reportType",
    "summary",
    "data"
  ],
  "additionalProperties": false
}
