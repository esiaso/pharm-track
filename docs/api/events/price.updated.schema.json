{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synergyone/pharmtrack/events/price.updated.schema.json",
  "type": "object",
  "properties": {
    "hptCode": {
      "type": "string",
      "minLength": 3,
      "description": "PPB HPT code"
    },
    "atcCode": {
      "type": "string",
      "pattern": "^[A-Z]\\d{2}[A-Z]{2}\\d{2}$",
      "description": "WHO ATC level-5 code"
    },
    "genericName": {
      "type": "string",
      "minLength": 1
    },
    "strength": {
      "type": "string",
      "minLength": 1
    },
    "unitOfIssue": {
      "type": "string",
      "minLength": 1
    },
    "priceListCode": {
      "type": "string",
      "minLength": 1
    },
    "unitPrice": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "currency": {
      "type": "string",
      "minLength": 1
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "hptCode",
    "atcCode",
    "genericName",
    "strength",
    "unitOfIssue",
    "priceListCode",
    "unitPrice",
    "currency",
    "effectiveFrom"
  ],
  "additionalProperties": false,
  "title": "price.updated"
}
