{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synergyone/pharmtrack/events/adr.reported.schema.json",
  "type": "object",
  "properties": {
    "adrId": {
      "type": "string",
      "format": "uuid"
    },
    "patientId": {
      "type": "string",
      "minLength": 1
    },
    "encounterId": {
      "type": [
        "string",
        "null"
      ]
    },
    "hptCode": {
      "type": "string",
      "minLength": 3,
      "description": "PPB HPT code"
    },
    "atcCode": {
      "type": "string",
      "pattern": "^[A-Z]\\d{2}[A-Z]{2}\\d{2}$",
      "description": "WHO ATC level-5 code"
    },
    "seriousness": {
      "type": "string",
      "minLength": 1
    },
    "onsetDate": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "adrId",
    "patientId",
    "encounterId",
    "hptCode",
    "atcCode",
    "seriousness",
    "onsetDate"
  ],
  "additionalProperties": false,
  "title": "adr.reported"
}
