{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synergyone/pharmtrack/events/drug.upserted.schema.json",
  "type": "object",
  "properties": {
    "drugId": {
      "type": "string",
      "format": "uuid"
    },
    "hptCode": {
      "type": "string",
      "minLength": 3,
      "description": "PPB HPT code"
    },
    "atcCode": {
      "type": "string",
      "pattern": "^[A-Z]\\d{2}[A-Z]{2}\\d{2}$",
      "description": "WHO ATC level-5 code"
    },
    "genericName": {
      "type": "string",
      "minLength": 1
    },
    "brandNames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strength": {
      "type": "string",
      "minLength": 1
    },
    "dosageForm": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "unitOfIssue": {
      "type": "string",
      "minLength": 1
    },
    "formularyStatus": {
      "enum": [
        "ACTIVE",
        "RESTRICTED",
        "NON_FORMULARY",
        "DISCONTINUED"
      ]
    },
    "controlledSchedule": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "drugId",
    "hptCode",
    "atcCode",
    "genericName",
    "brandNames",
    "strength",
    "dosageForm",
    "route",
    "unitOfIssue",
    "formularyStatus",
    "controlledSchedule",
    "version"
  ],
  "additionalProperties": false,
  "description": "Drug master change, for the prescription pad catalogue.",
  "title": "drug.upserted"
}
