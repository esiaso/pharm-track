# Where Next.js proxies /api requests (server side)
PHARMTRACK_API_URL=http://localhost:3000
# SynergyOne SSO. Leave NEXT_PUBLIC_SSO_AUTHORITY empty for dev mode (role picker, header auth).
NEXT_PUBLIC_SSO_AUTHORITY=
NEXT_PUBLIC_SSO_CLIENT_ID=pharmtrack-web
NEXT_PUBLIC_SSO_SCOPE=openid profile
# Must match the API's SSO_ROLES_CLAIM / SSO_ROLE_MAP / SSO_FACILITY_CLAIM
NEXT_PUBLIC_SSO_ROLES_CLAIM=roles
NEXT_PUBLIC_SSO_ROLE_MAP={}
NEXT_PUBLIC_SSO_FACILITY_CLAIM=facility_id
