# PostgreSQL connection for PharmTrack's own database
DATABASE_URL=postgresql://pharmtrack:pharmtrack@localhost:5432/pharmtrack
PORT=3000
# Base URLs of the sibling SynergyOne systems
CLINITRACK_BASE_URL=http://localhost:4000/api/v1
SUPPLYTRACK_BASE_URL=http://localhost:5000/api/v1
# Optional override for PPB HPT code validation (regex). See docs/ARCHITECTURE.md.
HPT_CODE_PATTERN=
# SMS gateway (refill reminders). SMS_PROVIDER=log only logs messages (dev default).
SMS_PROVIDER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
# dev-headers trusts x-user-id / x-user-roles headers (local only). Production must use SynergyOne SSO.
AUTH_MODE=dev-headers
# SynergyOne SSO (AUTH_MODE=oidc). Tokens are verified against the issuer's JWKS.
SSO_ISSUER=
SSO_AUDIENCE=pharmtrack
# Optional: JWKS URL if not discoverable from the issuer
SSO_JWKS_URL=
# Claim holding roles (dotted path allowed, e.g. realm_access.roles) and an optional rename map
SSO_ROLES_CLAIM=roles
SSO_ROLE_MAP={}
SSO_FACILITY_CLAIM=facility_id

# PPB ADR reporting targets in days (internal defaults; confirm against PPB guidance)
ADR_SERIOUS_DAYS=7
ADR_NON_SERIOUS_DAYS=30

# FHIR R4 facade (/api/v1/fhir/R4). Code system and identifier URIs; confirm against Kenya's FHIR guide.
FHIR_BASE_URL=
FHIR_HPT_SYSTEM=urn:synergyone:codesystem:ppb-hpt
FHIR_PATIENT_SYSTEM=urn:synergyone:clinitrack:patient
FHIR_ENCOUNTER_SYSTEM=urn:synergyone:clinitrack:encounter
FHIR_PRACTITIONER_SYSTEM=urn:synergyone:sso:user
FHIR_PRESCRIPTION_SYSTEM=urn:synergyone:clinitrack:prescription
# CliniTrack's FHIR base; when set, Patient references are absolute
FHIR_CLINITRACK_BASE=

# Retention (see docs/DATA-PROTECTION.md). The nightly job is off until enabled.
RETENTION_ENABLED=false
RETENTION_SMS_CONTENT_DAYS=90
RETENTION_INTEGRATION_PAYLOAD_DAYS=90
RETENTION_CONTACT_AFTER_OPT_OUT_DAYS=30
RETENTION_ACCESS_LOG_DAYS=2555
